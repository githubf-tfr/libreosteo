# Database
db.sqlite3

# Python compiled files
*.pyc

# Assets
# Pas de barre oblique finale : `postinstall` (package.json) crée ici un LIEN SYMBOLIQUE
# vers node_modules/@components, et git traite un lien comme un fichier ordinaire. Un motif
# à barre finale ne s'applique qu'aux répertoires : avec elle, le lien ressortait en `??` à
# chaque `git status` depuis le fork, et quatre lots l'ont contourné faute que la cause soit
# écrite quelque part. Le lien est de plus créé en chemin ABSOLU, parce que
# symlinkSync(..., 'junction') fait normaliser la cible par Node même hors Windows : il
# n'est donc portable d'aucun arbre de travail à un autre, raison de plus pour l'ignorer.
libreosteoweb/static/components
/static/
/media/
/node_modules/
/data/

# Indexes
whoosh_index/

# IDE Files
.idea
.idea/
.sublime-project
.sublime-workspace
.komodoproject
.idea
.project
.metadata

# VirtualEnv files
.env
.venv
env/
venv/

# log files
*.log
Libreosteo/settings/local.py*

# Tests / tooling artefacts
.coverage
/test-results/

# Claude Code local settings (sandbox-specific paths)
.claude/settings.local.json

# Local development tooling (sandbox-specific, never distributed)
.tools/
.uv-python/

# Ledger superpowers : jamais versionné
.superpowers/

# Export de production : donnees de sante nominatives, jamais versionnees
export-test/
