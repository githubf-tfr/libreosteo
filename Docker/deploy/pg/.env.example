# Variables du compose Docker/deploy/pg/docker-compose.yml.
# Copier en .env (ou fournir via `docker compose --env-file <chemin>`) et adapter les
# chemins : ce fichier n'est qu'un exemple, aucune valeur ci-dessous n'est un secret
# réel à réutiliser tel quel en production.
#
# Chemins hôte montés en volumes (créer les répertoires avant `docker compose up`).
# Exemple observé en recette S4 : un répertoire de travail jetable sous le scratchpad
# de session, avec des sous-dossiers db/, bak/, data/, settings/ — chemin documenté
# comme paramètre, jamais en dur dans ce fichier.
LIBREOSTEO_DB_STORAGE=/chemin/vers/travail/db
LIBREOSTEO_BAK_STORAGE=/chemin/vers/travail/bak
DATA=/chemin/vers/travail/data
SETTINGS=/chemin/vers/travail/settings

# Identifiants PostgreSQL. Valeurs ci-dessous jetables, utilisées telles quelles pour
# la recette S4 (montage de bout en bout, cf. docs/superpowers/plans/recette-montage.md) ;
# à remplacer par des valeurs propres pour tout usage réel.
POSTGRES_USER=libreosteo
POSTGRES_PASSWORD=recette
